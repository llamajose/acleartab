{
  "manifest_version": 3,
  "name": "acleartab",
  "version": "1.5",
  "description": "A Liquid Glass new tab: smart search, Canvas due dates, homelab status, weather, and quick links.",
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },
  "background": {
    "service_worker": "src/js/background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "history",
    "favicon"
  ],
  "host_permissions": [
    "https://wttr.in/*",
    "https://suggestqueries.google.com/*",
    "https://api.frankfurter.app/*",
    "https://*.instructure.com/*",
    "http://*.ts.net/*",
    "https://*.ts.net/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
